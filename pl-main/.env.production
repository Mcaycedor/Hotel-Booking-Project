# Production Environment Configuration
# Copy this to AWS Parameter Store or Secrets Manager

# == Application Settings ==
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# == Database ==
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/profiler?retryWrites=true&w=majority
MONGODB_DATABASE=profiler_db

# == OpenAI API ==
OPENAI_API_KEY=sk-<your-openai-key>
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# == CORS & Security ==
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
JWT_SECRET=<generate-strong-secret-key>
JWT_EXPIRY_MINUTES=60

# == Logging ==
LOG_LEVEL=Information
LOG_FILE_PATH=/var/log/profiler/api.log

# == AWS ==
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-aws-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret>

# == Application ==
MAX_FILE_UPLOAD_SIZE_MB=10
MAX_RESUME_LENGTH_CHARS=50000
ASSESSMENT_CACHE_DURATION_MINUTES=30

# == Rate Limiting ==
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_OPENAI_CALLS_PER_HOUR=1000

# == Email (Optional) ==
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your-email>
SMTP_PASSWORD=<app-password>
SENDER_EMAIL=noreply@yourdomain.com
