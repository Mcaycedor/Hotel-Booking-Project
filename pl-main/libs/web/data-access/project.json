{
  "name": "web-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/data-access/src",
  "prefix": "app",
  "tags": ["scope:web", "type:lib", "type:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/libs/web/data-access"],
      "options": {
        "outputPath": "dist/libs/web/data-access",
        "tsConfig": "libs/web/data-access/tsconfig.lib.json",
        "main": "libs/web/data-access/src/index.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/data-access/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
